### ============================================
### CONECTAAI GATEWAY API - COMPLETE AUTH TEST SUITE
### ============================================

### ============================================
### 1. AUTHENTICATION ENDPOINTS
### ============================================

### 1.1 Register New User
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "Test@123",
  "confirmPassword": "Test@123"
}

> {%
  if (response.status === 201) {
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
    client.log("✅ Registration successful!");
    client.log("Access Token: " + response.body.access_token);
    client.log("Refresh Token: " + response.body.refresh_token);
  } else {
    client.log("❌ Registration failed: " + response.status);
  }
%}

### 1.2 Login User
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "phelipe.pereira0811@gmail.com",
  "password": "Lipe@0811"
}

> {%
  if (response.status === 200) {
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
    client.log("✅ Login successful!");
    client.log("Access Token: " + response.body.access_token);
    client.log("Refresh Token: " + response.body.refresh_token);
  } else {
    client.log("❌ Login failed: " + response.status);
  }
%}

### 1.3 Refresh Token
POST http://localhost:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}

> {%
  if (response.status === 200) {
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
    client.log("✅ Token refreshed successfully!");
    client.log("New Access Token: " + response.body.access_token);
    client.log("New Refresh Token: " + response.body.refresh_token);
  } else {
    client.log("❌ Token refresh failed: " + response.status);
  }
%}

### 1.4 Get Current User Info
GET http://localhost:8080/api/v1/auth/me
Authorization: Bearer {{access_token}}

> {%
  if (response.status === 200) {
    client.log("✅ User info retrieved successfully!");
    client.log("User: " + JSON.stringify(response.body));
  } else {
    client.log("❌ Failed to get user info: " + response.status);
  }
%}

### 1.5 Change Password
POST http://localhost:8080/api/v1/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "currentPassword": "Lipe@0811",
  "newPassword": "NewPassword@123",
  "confirmPassword": "NewPassword@123"
}

> {%
  if (response.status === 200) {
    client.log("✅ Password changed successfully!");
  } else {
    client.log("❌ Password change failed: " + response.status);
  }
%}

### 1.6 Forgot Password
POST http://localhost:8080/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "phelipe.pereira0811@gmail.com"
}

> {%
  if (response.status === 200) {
    client.log("✅ Password reset email sent!");
  } else {
    client.log("❌ Forgot password failed: " + response.status);
  }
%}

### 1.7 Reset Password (requires valid token from email)
POST http://localhost:8080/api/v1/auth/reset-password
Content-Type: application/json

{
  "token": "VALID_RESET_TOKEN_FROM_EMAIL",
  "newPassword": "NewPassword@456",
  "confirmPassword": "NewPassword@456"
}

> {%
  if (response.status === 200) {
    client.log("✅ Password reset successfully!");
  } else {
    client.log("❌ Password reset failed: " + response.status);
  }
%}

### 1.8 Logout User
POST http://localhost:8080/api/v1/auth/logout
Authorization: Bearer {{access_token}}

> {%
  if (response.status === 204) {
    client.log("✅ Logout successful!");
    client.global.clear("access_token");
    client.global.clear("refresh_token");
  } else {
    client.log("❌ Logout failed: " + response.status);
  }
%}

### ============================================
### 2. ERROR SCENARIOS TESTING
### ============================================

### 2.1 Login with Invalid Credentials
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "invalid@example.com",
  "password": "wrongpassword"
}

> {%
  client.log("Expected 401/400: " + response.status);
%}

### 2.2 Login with Invalid Email Format
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "password"
}

> {%
  client.log("Expected 400: " + response.status);
%}

### 2.3 Register with Existing Email
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "existinguser",
  "email": "phelipe.pereira0811@gmail.com",
  "password": "Password@123",
  "confirmPassword": "Password@123"
}

> {%
  client.log("Expected 409: " + response.status);
%}

### 2.4 Access Protected Endpoint Without Token
GET http://localhost:8080/api/v1/auth/me

> {%
  client.log("Expected 401: " + response.status);
%}

### 2.5 Access Protected Endpoint with Invalid Token
GET http://localhost:8080/api/v1/auth/me
Authorization: Bearer invalid_token_here

> {%
  client.log("Expected 401: " + response.status);
%}

### 2.6 Refresh with Invalid Token
POST http://localhost:8080/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "invalid_refresh_token"
}

> {%
  client.log("Expected 400/401: " + response.status);
%}

